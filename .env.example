# Public (can live in .env)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # or the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SITE_URL=           # e.g. https://app.example.com; base of links in e-mails (empty = request origin)

# Secret (.env.local only)
SUPABASE_SECRET_KEY=            # server only, bypasses RLS (or the legacy SUPABASE_SERVICE_ROLE_KEY)
INVITE_CODE=                    # closed registration; empty = registration closed
PUBLIC_SIGNUP_ENABLED=false     # true = sign-up from the website without a code, 14-day trial; false = invites + waitlist
GOOGLE_MAPS_API_KEY=            # Places API (New), server only
ANTHROPIC_API_KEY=              # Jarvis, server only
RESEND_API_KEY=                 # e-mails
RESEND_FROM=                    # sender once the domain is verified on Resend, e.g. "Gradus <hello@example.com>";
                                # empty = Resend's test sender, which can mail only the Resend account's own address
OWNER_EMAIL=                    # where ideas from Jarvis and plan requests go; empty = the owner account's e-mail
CRON_SECRET=                    # verifies Vercel Cron requests

INTEGRATIONS_ENCRYPTION_KEY=    # encrypts per-user integration secrets (Fakturoid) in the DB; 32 bytes, base64:
                                # openssl rand -base64 32 — never change it once users have connected

# Fakturoid credentials are stored per user, encrypted in the DB — not in env.
