{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/call-time-stats",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/recurring-payments",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/jarvis?task=watch",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/jarvis?task=briefing",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/analytics-retention",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/metrics-daily",
      "schedule": "45 1 * * *"
    },
    {
      "path": "/api/cron/notes-trash",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/error-alerts",
      "schedule": "0 7 * * *"
    }
  ]
}
